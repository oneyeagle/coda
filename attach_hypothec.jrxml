			<componentElement>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="550" width="555" height="100" uuid="24103be7-1a1b-453e-bc17-27ad30ee938a"/>
				<jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical">
					<datasetRun subDataset="Properties" uuid="7b6540d6-7b7d-45b3-993c-80697584aba7">
						<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{properties})]]></dataSourceExpression>
					</datasetRun>
					<jr:listContents height="100" width="555">
						<frame>
							<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="0" y="0" width="555" height="100" uuid="a4a9757e-c3c6-4b7b-b532-1c4e12fd84b2"/>
							<staticText>
								<reportElement x="0" y="1" width="160" height="15" uuid="c066cbff-51c4-404d-ba99-9cf4a35cffc1">
									<property name="com.jaspersoft.studio.unit.height" value="px"/>
								</reportElement>
								<textElement>
									<font fontName="Times New Roman" size="10"/>
								</textElement>
								<text><![CDATA[Dénomination :]]></text>
							</staticText>
							<textField textAdjust="StretchHeight" isBlankWhenNull="true">
								<reportElement x="160" y="0" width="340" height="16" uuid="510e1d2f-0bd9-4c34-88e8-e37a91fd1e95"/>
								<textElement>
									<font fontName="Times New Roman" size="10" isBold="true"/>
								</textElement>
								<textFieldExpression><![CDATA[$F{nomBien}]]></textFieldExpression>

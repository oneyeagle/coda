w:lang w:bidi="ar-MA"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00975F06"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr><w:t>»</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr><w:t xml:space="preserve"> يعني الفعل الطوعي المتمثل في (ي) إعطاء، عرض، أو وعد لأي شخص (بما في ذلك أي موظف عمومي)، أو (ي ي) قبول شيء من أي شخص (بما في ذلك أي موظف عمومي)، بطريقة مباشرة أو غير مباشرة، أي هدية، دعوة، مكافأة، أو شيء ذو قيمة، لحسابه الخاص أو لحساب طرف ثالث، في جميع الحالات بهدف استغلال نفوذه الحقيقي أو المفترض للحصول على قرار ايجابي أو أو ميزة غير مستحقة من موظف العمومي</w:t></w:r></w:p><w:p w14:paraId="51AE4BB1" w14:textId="77777777" w:rsidR="00B201EC" w:rsidRPr="00975F06" w:rsidRDefault="00B201EC" w:rsidP="00B201EC"><w:pPr><w:tabs><w:tab w:val="right" w:pos="709"/></w:tabs><w:spacing w:after="360"/><w:jc w:val="right"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="ar-MA"/></w:rPr></w:pPr><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr><w:t>[المقترض] يقر ويتعهد [للبنك] في جميع الأوقات وطوال مدة العقد، أنه</w:t></w:r><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="ar-MA"/></w:rPr><w:t>:</w:t></w:r></w:p><w:p w14:paraId="269A976D" w14:textId="77777777" w:rsidR="00B201EC" w:rsidRPr="00975F06" w:rsidRDefault="00B201EC" w:rsidP="00B201EC"><w:pPr><w:tabs><w:tab w:val="right" w:pos="709"/></w:tabs><w:spacing w:after="360"/><w:jc w:val="right"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="ar-MA"/></w:rPr></w:pPr><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr><w:t>ـــ مطلع وملتزم بالامتثال لجميع القوانين الجاري بها العمل في مكافحة الرشوة واستغلال النفوذ والمطبقة في تنفيذ العقد؛</w:t></w:r><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="ar-MA"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="13AFE713" w14:textId="77777777" w:rsidR="00B201EC" w:rsidRPr="00975F06" w:rsidRDefault="00B201EC" w:rsidP="00B201EC"><w:pPr><w:tabs><w:tab w:val="right" w:pos="709"/></w:tabs><w:spacing w:after="360"/><w:jc w:val="right"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="ar-MA"/></w:rPr></w:pPr><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr><w:t>ـــ لا [المقترض]، ولا إن وجد - أي وكيل أو وسيط تم تعيينه لتنفيذ العقد: (أ) لم يرتكب أي فعل للرشوة أو استغلال النفوذ؛ (ب) ولم يتعرض لأي حظر أو منع (أو يعامل كذلك) من قبل أي هيئة وطنية أو دولية للرد على طلبات العروض أو ابرام العقود أو العمل مع تلك الهيئة، بسبب أفعال الرشوة أو استغلال النفوذ مؤكدة كانت أو مفترضة</w:t></w:r><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="ar-MA"/></w:rPr><w:t xml:space="preserve">:     </w:t></w:r></w:p><w:p w14:paraId="5E407966" w14:textId="77777777" w:rsidR="00B201EC" w:rsidRPr="00975F06" w:rsidRDefault="00B201EC" w:rsidP="00B201EC"><w:pPr><w:tabs><w:tab w:val="right" w:pos="709"/></w:tabs><w:spacing w:after="360"/><w:jc w:val="right"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr></w:pPr><w:r w:rsidRPr="00975F06"><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/><w:rtl/><w:lang w:bidi="ar-MA"/></w:rPr><w:t>ـــ [البنك] له الحق في إنهاء هذا العقد وفقًا للأحكام القانونية، كتابة عن طريق تسليم اليد شخصيا أو عبر البريد المضمون مع الإشعار بالتوصل إلى [المقترض]، دون تعويض [بغض النظر عن أي حكم آخر من الشروط العامة]، إذا ارتكب [المقترض] فعلا للرشوة أو استغلالا للنفوذ، أو إخلالا بالالتزامات الناشئة عن العقد، أو إذا لم تعد تصريحاته وضماناته صالحة (سواء أمكن تصحيح ذلك الإخلال أم لا)</w:t></w:r></w:p><w:p w14:paraId="6A7E326B" w14:textId="77777777" w:rsidR="00B61811" w:rsidRDefault="00B61811" w:rsidP="00B61811"><w:pP
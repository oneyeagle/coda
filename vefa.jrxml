				<staticText>
					<reportElement x="273" y="359" width="279" height="133" uuid="f1de7084-eeae-4c3c-84ff-d1be4b89af17">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
					</reportElement>
					<box padding="0">
						<pen lineWidth="1.0" lineStyle="Dotted"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Top">
						<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
						<paragraph rightIndent="4"/>
					</textElement>
					<text><![CDATA[يلتزم المقترض بإحلال للبنك، بموجب عقد منفصل، الذي سيشكل طرف،من بين الحاضرين، لحقوقهم وفعالهم الناجمة عن الضمانات البنكية، المؤسسة لصالحها ودلك وفقا لظهير الحامل لقانون رقم 00-44 بتاريخ 3 أكتوبر 2002.


تنتهي هذه الضمانة بصفة آلية بمجرد تقييد الرهن من الدرجة الأولى لفائدة البنك على الرسم العقاري الجزئي المخصص للمقترض بعد تقسيم الرسم العقاري الأصلي
]]></text>
				</staticText>

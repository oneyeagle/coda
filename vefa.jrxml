					<textElement textAlignment="Left" verticalAlignment="Top">
						<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
						<paragraph leftIndent="4"/>
					</textElement>
					<text><![CDATA[La présente OPC a pour objet de parfaire le financement de l’acquisition d’un logement dans le cadre d’une vente en état future d’achèvement portant sur la totalité de la propriété en cours de construction désignée ci après :]]></text>
				</staticText>
				<staticText>
					<reportElement x="277" y="28" width="274" height="62" uuid="2bcd28e8-a692-451b-a276-a0159c1c7a09">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
					</reportElement>
					<box padding="0">
						<pen lineWidth="1.0" lineStyle="Dotted"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Top">
						<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					</textElement>
					<text><![CDATA[موضوع العرض المسبق الحالي للقرض هو تمويل اقتناء السكن في إطار بيع عقار في طور الإنشاء المتعلق  بمجموع الملكية في طور البناء المعينة أسفله :]]></text>
				</staticText>
				<staticText>
					<reportElement x="277" y="0" width="274" height="27" uuid="610d51bd-6a9d-4c1f-9d47-8552ef6bbf46">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.rightIndent" value="px"/>
					</reportElement>
					<box padding="0">
						<pen lineWidth="1.0" lineStyle="Dotted"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Times New Roman" size="12" isBold="true" isUnderline="true"/>
						<paragraph rightIndent="10"/>
					</textElement>
					<text><![CDATA[الفصل 2: الموضوع]]></text>
				</staticText>
				<staticText>
					<reportElement x="1" y="0" width="275" height="27" uuid="8f65f974-40d8-46dd-ba1b-eb641aa01d7f">
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
						<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
					</reportElement>
					<box padding="0">
						<pen lineWidth="1.0" lineStyle="Dotted"/>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="Times New Roman" size="12" isBold="true" isUnderline="true"/>
						<paragraph leftIndent="10"/>

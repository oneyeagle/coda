				</textElement>
				<textFieldExpression><![CDATA["1.1 DESIGNATION DE LA BANQUE"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="61" width="276" height="66" uuid="8526773e-e982-43cf-9fc0-bb4bb98f58c0"/><box/><textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Times New Roman" size="10.5" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA["SAHAM BANK, Société Anonyme à Directoire et à Conseil de Surveillance au capital de 2.152.500.000,00DH, dont le siège social est à CASABLANCA, 55 Boulevard Abdelmoumen, immatriculée au Registre de commerce de Casablanca sous le n° 28987 du Registre analytique,  valablement représentée par :"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="29" width="276" height="18" uuid="eadd73e9-340f-4189-a54e-efe04c63044c"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="true" isUnderline="true"/>
					<paragraph leftIndent="0" rightIndent="10"/>
				</textElement>
				<textFieldExpression><![CDATA["الفصـــل 1: هــويـــة الأطـــــراف"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="47" width="276" height="15" uuid="63bba3a9-0db9-428e-b651-88574964a2ed"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="true" isUnderline="true"/>
					<paragraph rightIndent="15"/>
				</textElement>
				<textFieldExpression><![CDATA["1.1 هويـــة الــبـنــك"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="278" y="62" width="274" height="64" uuid="114abf2f-2ab3-4cd3-be3f-378dbde714f0"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA["سهام بنك ، شــركــــة مساهمــة ذات مجلــــس مــراقبــــة و إدارة جـمـــاعيـــة، رأسمـــالهـــا  2.152.500.000,00 درهـــم، الكـــائــــــن مقـــــــرها بالبيضـــــاء، 55 شـــارع عبـــد المـــومـــــن، المقيــــــدة بالسجــــــل التجــــــاري للدار البيضــاء تحت رقــــم  28987  مــن السجـل التحليلــي، يمثلهــــا:"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="75"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="552" height="15" uuid="e8198ea5-4336-4763-b21f-2e1cf2daa253" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="552" height="15" uuid="531ac665-aa28-4c14-9f81-209c806e7b81"/><box/><textElement textAlignment="Right" verticalAlignment="Top">

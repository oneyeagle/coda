				</textElement>
				<textFieldExpression><![CDATA["Compte n°  :"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="68" y="43" width="372" height="15" uuid="ccc70a6a-362c-417a-b0c0-b6998b58e60b"/><box><bottomPen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></box><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{customerRib}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="440" y="43" width="112" height="15" uuid="5c77eb7a-f06b-4edb-a815-cfa8c1d2e146"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA["رقم الحساب  : "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="57"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="57" uuid="43efb8a7-1047-4bfe-ba78-26a595aefe55" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="57" uuid="60e45b40-47dd-47f3-b019-380045ffcb4b" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="57" uuid="e96676e7-6e5b-4263-b010-3dc10ab225ed"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<textFieldExpression><![CDATA[" L'Emprunteur s'engage à maintenir ce compte de prélèvement jusqu'au remboursement intégral du Crédit sauf accord express de la Banque."]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="57" uuid="361321f2-90c2-46d2-8dbc-cba97f425c70"/><box/><textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA[" يلتزم المقترض بالمحافظة على حساب الإقتطاع المشار إليه أعلاه إلى حين التسديد الكامل للقرض باستثناء وجود موافقة صريحة للبنك."]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="102"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="35" uuid="bab58f3f-39c9-4ac6-bbda-5bfb82fa410c" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="35" uuid="748630b6-9fd6-4c99-ade4-af897914b7b2" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="20" uuid="0aadb1ff-5b42-47e3-9be6-b556778630ca"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA[" ARTICLE 5 : GARANTIES"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="21" width="276" height="14" uuid="ece24dd4-227e-4182-b7e1-4dd3900f8a2e"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA[" 5.1 GARANTIE  HYPOTHECAIRE"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="1" width="276" height="19" uuid="d1728dc4-bb57-4ac1-a8b1-4e364a7da7b3"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="true" isUnderline="true"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA[" الفصل 5 : الضمانات"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="21" width="276" height="14" uuid="7c3488e9-598a-47e0-943a-56f8f160a492"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="true" isUnderline="true"/>
					<paragraph rightIndent="10"/>
				</textElement>
				<textFieldExpression><![CDATA[" 5.1  الرهن العقاري "]]></textFieldExpression></textField></elementGroup><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="35" width="276" height="67" uuid="9bd84a6b-d5d3-4fd8-a802-c1001d1f73b1" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="35" width="276" height="67" uuid="08a9dd50-b1f2-42ab-b40c-a89a26084170" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="35" width="276" height="67" uuid="47ec6d46-f580-432a-b879-ee1bb996a5c9"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<textFieldExpression><![CDATA["En garantie du remboursement du Crédit en capital outre les intérêts, commissions, frais et accessoires, l’Emprunteur confère à la Banque les garanties indiquées ci-après, objet des annexes ci-jointes ou actes séparés faisant partie intégrante des présentes :"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="35" width="276" height="67" uuid="ca34e518-b228-4711-83ce-21e39ac44763"/><box/><textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA["يمنح المقترض للبنك، ضمانا لتسديد مبلغ القرض من رأسمال، فوائد، عمولات، مصاريف و توابع الضمانات التالية موضوع الملحقات أو العقود المنفصلة المعتبرة جزءا لا يتجزأ من هذا العقد:"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="21"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="552" height="21" uuid="b32f7a92-57ac-44de-abd5-bd7c2e654428" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="429" height="21" uuid="9faabd97-9249-4c1c-9c4f-e7b738fad71f"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{hypothec} == null ? "" : $F{hypothec}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="429" y="0" width="123" height="21" uuid="37dbf1e6-0923-4492-8ef9-16d5bfaedf23"/><box/><textElement textAlignment="Right">
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["  - رهن عقاري  من الدرجة :  "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="28"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="552" height="28" uuid="fd833fab-1e35-4d42-8836-016bd21a884e" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="490" height="28" uuid="e51f166e-5d6d-4dac-9519-2e3ccb1f8e62"/><box/><textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false"/>
					<paragraph leftIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{warrantyAmount} == null ? "" : "  A hauteur de la somme en principal de " + $F{warrantyAmount}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="490" y="0" width="62" height="28" uuid="e48bdf31-c621-4bec-bad0-8aef3b99f4a2"/><box/><textElement textAlignment="Center">
					<font fontName="Times New Roman" size="11"/>
					<paragraph rightIndent="2"/>
				</textElement>
				<textFieldExpression><![CDATA[" في حدود مبلغ كأصل الدين"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="14"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="14" uuid="c52e8bec-480f-49bc-94b1-c9533011c26b" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="14" uuid="3ccf2fc1-99f3-4e0f-b9b9-2a11a5061534" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="14" uuid="8da9cd25-290b-4f7c-a234-f077adba3840"/><box/><textElement>
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["  outre les intérêts, frais et accessoires "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="14" uuid="a71765cf-66f7-47e9-9575-bda90547616c"/><box/><textElement textAlignment="Right">
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[" بالإضافة إلى الفوائد، المصاريف و التوابع   "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="16"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="16" uuid="04bf183a-b3e0-4f8f-b64d-4a7b77764090" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="16" uuid="e2025ceb-904c-4e90-ade5-5e7c6f1c638e" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="16" uuid="af67a50c-3875-4683-9699-ec0c5161a547"/><box/><textElement>
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["  sur la totalité de la propriété objet du titre foncier "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="16" uuid="20b5f2eb-e3c2-4dd8-a64c-b705c99c0bba"/><box/><textElement textAlignment="Right">
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["  على مجموع الملكية موضوع الرسم العقاري   "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="20"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="552" height="20" uuid="f564c2af-3b8a-479b-9335-872c8d121a38" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="49" height="20" uuid="6c45c790-c786-46c9-bd55-8fcf969c3f4e"/><box/><textElement>
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["  n° :  "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="49" y="0" width="470" height="20" uuid="5787f5c9-9e4d-4c64-aa5f-bc8800f77c2e"/><box><bottomPen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></box><textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{warrantyLandCertificate} == null ? "" : $F{warrantyLandCertificate}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="519" y="0" width="33" height="20" uuid="74f71e81-458d-4364-86dd-0ff7288bc4b4"/><box/><textElement textAlignment="Right">
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["  عدد :   "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="56"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="36" uuid="d19c32cd-c0ef-49c3-b285-a97d1c8d5a7b" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="36" uuid="7b60285e-5d19-4ef4-b2da-00a4c396284a" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="20" uuid="09447e23-8c23-4c76-b929-65c15c00dbfb"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" isUnderline="true"/>
					<paragraph leftIndent="10"/>
				</textElement>
				<textFieldExpression><![CDATA["5.2 AUTRES GARANTIES"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="20" width="276" height="16" uuid="183f6746-0107-4044-8220-32dd0de799c8"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA[" Le Crédit est assorti également des garanties  suivantes :"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="20" uuid="b27a8b13-5359-4be5-9d6e-b0b0e01df62c"/><box/><textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" isUnderline="true"/>
					<paragraph rightIndent="10"/>
				</textElement>
				<textFieldExpression><![CDATA["5.2  ضمانات أخرى"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="20" width="276" height="16" uuid="2c35d3ab-67bd-4a3c-986b-a4185a03e60b"/><box/><textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA["يتضمن هذا القرض أيضا الضمانات التالية: "]]></textFieldExpression></textField></elementGroup><componentElement><reportElement positionType="Float" x="0" y="36" width="552" height="20" isRemoveLineWhenBlank="true" uuid="a00e9616-4bb9-48c8-ba15-7e0d3caa3427"><printWhenExpression><![CDATA[$F{warranties} != null && !$F{warranties}.isEmpty()]]></printWhenExpression></reportElement><jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" printOrder="Vertical"><datasetRun subDataset="Warranties" uuid="61272a01-2a8b-4d35-9b11-478c497477f3">
							<dataSourceExpression>$F{warranties} != null &amp;&amp; !$F{warranties}.isEmpty()
            ? new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{warranties})
            : new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource(java.util.Collections.emptyList())</dataSourceExpression>
						</datasetRun>
						<jr:listContents height="20" width="552"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="552" height="20" isRemoveLineWhenBlank="true" uuid="238325f5-3acf-4796-9d36-9a441751a6dd" mode="Transparent"><printWhenExpression><![CDATA[$F{_THIS} != null && !$F{_THIS}.isEmpty()]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="2" width="552" height="16" isRemoveLineWhenBlank="true" uuid="7efcc4ea-c625-41e9-a2d3-5613ab78f881"><printWhenExpression><![CDATA[$F{_THIS} != null && !$F{_THIS}.isEmpty()]]></printWhenExpression></reportElement><box><bottomPen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></box><textElement textAlignment="Left" verticalAlignment="Top">
									<font fontName="Times New Roman" size="11" isBold="true"/>

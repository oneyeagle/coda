					<textFieldExpression><![CDATA["العــــرض المسبـــــق للقــــــرض يجب أن يكون مؤشرا  في كل الصفحات من طرف جميع الأطراف\n"]]></textFieldExpression></textField></elementGroup></band></detail><pageFooter><band height="16" splitType="Stretch"><textField evaluationTime="Master"><reportElement x="0" y="2" width="552" height="14" uuid="d0c32486-2e0f-4fa0-83c6-a782d0bb6302"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="8"/></textElement><textFieldExpression><![CDATA["Page " + $V{MASTER_CURRENT_PAGE} + " / " + $V{MASTER_TOTAL_PAGES}]]></textFieldExpression></textField></band></pageFooter></jasperReport>

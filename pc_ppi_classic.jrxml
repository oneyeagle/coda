					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[": "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="199" y="0" width="270" height="14" uuid="bde1b269-f2b5-49ee-8f2f-4164b640bc02"/><box><bottomPen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></box><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{lastInstallmentDate}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="469" y="0" width="83" height="14" uuid="52450fec-a8d1-47fa-89fe-f148799d25b8"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["تاريخ القسط الأخير :"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="109"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="109" uuid="6c421a98-471d-4cb5-9b50-f2e16cec007e" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="109" uuid="93fe7574-ff6a-41ad-abd0-4bef90513cc8" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="109" uuid="8cc5fb4a-ba13-47d9-a2d9-51d8531996fa"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<textFieldExpression><![CDATA["Il reste entendu que le tableau d’amortissement annexé aux présentes est délivré par la Banque à l’Emprunteur à titre indicatif\nLe tableau d’amortissement définitif ne sera remis à l’Emprunteur pour approbation et signature qu’après déblocage effectif du crédit. Ce tableau d’amortissement sera considéré de convention expresse comme faisant partie intégrante des présentes.\n\n"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="109" uuid="a9d2d30e-def9-4b61-94fd-915836a84479"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="4"/>
				</textElement>
				<textFieldExpression><![CDATA[" يبقى من المتفق عليه أن جدول الإستخمادات المرفق بهذا العرض هو مسلم من طرف البنك إلى المقترض على سبيل الإشارة فقط.\n\nلن يتم تسليم جدول الإستخماد النهائي إلى المقترض من أجل المصادقة عليه وتوقيعه إلا بعد الإفراج الفعلي عن القرض، و باتفاق صريح بين الأطراف فإنه سيتم اعتبار  هذا الجدول بمثابة جزء لا يتجزأ من هذا العقد .\n"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="15"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="552" height="15" uuid="874d6312-9ca4-44e9-a19b-2d3ac3813d13" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="99" height="15" uuid="d21dd84e-ecd9-44b7-8f21-1387f7f1439b"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[" - Durée du Différé  : "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="99" y="0" width="400" height="15" uuid="efcf7be6-7025-4f0d-993c-9a0ee0c1da3d"/><box><bottomPen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></box><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{deferredDuration}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="499" y="0" width="53" height="15" uuid="4a9727cd-0b77-4e28-908b-ddba36035ee3"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["  - مدة الإعفاء :  "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="14"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="14" uuid="b52bc1a0-8cc8-4486-89d9-8d5918bc2380" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="14" uuid="741cfcc2-bfee-4225-b1fd-a0a393277f52" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="14" uuid="f597538d-dfe9-44f7-a648-752c6ee195cb"/><box/><textElement>
					<font fontName="Times New Roman" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[" (préciser en "+$P{deferredType}+")"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="14" uuid="dc33f5a6-3efd-4b43-ae01-becaf6c0811e"/><box/><textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["  ( تحديد رأسمال فقط أم رأسمال و فائدة)"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="52"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="14" uuid="06a3ea93-24dc-4430-a651-562713c99718" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="14" uuid="39dc3a00-deaa-48c3-80ad-c471509313d3" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="14" uuid="f05125a1-23a4-4be2-b8b4-cb97ca76e758"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[" - Coût total du Crédit (somme des intérêts + frais et commissions) :  "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="14" uuid="685a98fd-5653-4ba1-90e0-61c28234cbc9"/><box/><textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["  (- الكلفة الإجمالية للقرض ( مبلغ الفوائد + مصاريف  عمولات"]]></textFieldExpression></textField></elementGroup><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="14" width="552" height="14" uuid="b4210f2a-be3e-4ef4-9f7b-356f1a95eee5" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="14" width="552" height="14" uuid="d27dcd85-133b-4466-95cb-8373fb53d8c2"/><box/><textElement textAlignment="Center">
					<font fontName="Times New Roman" size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{totalCreditCost}]]></textFieldExpression></textField></elementGroup><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="28" width="276" height="24" uuid="2a72ce7b-ed45-4c73-920a-a0dc80cfe081" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="28" width="276" height="24" uuid="d0217d54-57a0-4ef4-a90f-ab90bd4c9b99" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="28" width="276" height="24" uuid="dfe958ee-03f2-405e-9379-8ed06abbb71c"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["DH (si le taux ne subit aucun changement durant toute la période du prêt)"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="28" width="276" height="24" uuid="de1de424-8b82-4903-9f4f-ad014528767f"/><box/><textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["درهم ( إذا لم يطرأ أي تغيير على سعر الفائدة خلال فترة القرض )"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="46"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="18" uuid="69ed579f-ae3c-48ec-b466-c72da7402414" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="18" uuid="d7a8c25d-fb6d-4d81-b3c5-b99c5b6c7318" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="18" uuid="fec1a2b8-5065-4a92-8559-57a86038e8be"/><box/><textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="true" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["  - Coût total des Sûretés Réelles : "]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="18" uuid="67ca0c82-7221-4131-bce1-388196302cbf"/><box/><textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="true" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["- تقدير تكلفة الضمانات الفعلية:"]]></textFieldExpression></textField></elementGroup><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="18" width="552" height="14" uuid="cd6b3f04-42c2-4e4a-935d-5cc3c1ec8132" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="18" width="85" height="14" uuid="1601a431-0b5c-45ec-89d0-36337a1c4afe"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[" Enregistrement :  "]]></textFieldExpression></textField><line><reportElement positionType="Float" x="85" y="30" width="404" height="1" forecolor="#A3A2A2" uuid="023270af-a38c-41bd-8dcf-885bd7d25698"/><graphicElement><pen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></graphicElement></line><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="489" y="18" width="63" height="14" uuid="1f53713a-1a43-403c-bb82-ae068079c716"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="8"/>
				</textElement>
				<textFieldExpression><![CDATA["التسجيل    :  "]]></textFieldExpression></textField></elementGroup><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="32" width="552" height="14" uuid="613030ee-10e0-4172-89d4-910f7ac94751" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="32" width="116" height="14" uuid="5e7e33c5-b071-487d-8804-da5bd0b2df47"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA[" Conservation Foncière :  "]]></textFieldExpression></textField><line><reportElement positionType="Float" x="116" y="44" width="354" height="1" forecolor="#A3A2A2" uuid="5a29be0c-1df0-4739-afa2-efe3080d098c"/><graphicElement><pen lineWidth="1.0" lineStyle="Dotted" lineColor="#A3A2A2"/></graphicElement></line><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="470" y="32" width="82" height="14" uuid="480fb521-f8cc-4ea1-a547-574b62738795"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["    التحفيظ العقاري   :  "]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="41"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="41" uuid="291ec154-682e-4eb5-a852-7f280ac6a1e0" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="41" uuid="3419f8a6-77b1-4226-b8ba-0e00e77faccc" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="41" uuid="b3d60f31-0936-4378-b3bf-8d0427cae0e0"/><box/><textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="2"/>
				</textElement>
				<textFieldExpression><![CDATA[" D’autre frais seront également à la charge de l’Emprunteur notamment les frais de timbre de légalisation de signature et du notaire."]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="41" uuid="b1b9e9f1-6682-4f5a-8196-8596b642bd45"/><box/><textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["  و ذلك دون احتساب المصاريف الأخرى التي تبقى على عاتق المقترض كمصاريف التنبر، تصحيح الإمضاء و مصاريف الموثق أو أي جهة أخرى مكلفة بتحرير عقود الضمانات أو غيرها، المتعلقة بهذا القرض."]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="69"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="0" width="276" height="69" uuid="9b4de42a-aa9f-4cc6-89d6-84f2424898b7" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="0" width="276" height="69" uuid="3b07b40a-2b1b-4436-ac0e-267b56ad6f7a" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="0" width="276" height="69" uuid="212d54aa-6403-4050-83a0-d85c95535410"/><box/><textElement textAlignment="Left" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="10" isBold="false" isUnderline="false"/>
					<paragraph leftIndent="2" rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["-Données à caractère personnel\n ☐ En cochant cette case, L’Emprunteur (et/ou la caution) accepte de recevoir de la Banque des offres et des informations commerciales et ce, à travers tout moyen (téléphone, télécopieur, courrier électronique,…), dans le cadre des opérations marketing destinées à la clientèle.\n"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="276" y="0" width="276" height="69" uuid="8abbdc28-3027-422d-addd-00178a831b27"/><box/><textElement textAlignment="Right" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
					<paragraph rightIndent="3"/>
				</textElement>
				<textFieldExpression><![CDATA["المعطيات ذات الطابع الشخصي\nبملء هذا الإطار  ☐\n يقبل المقترض و/أو الكفيل التوصل من طرف البنك في إطار عمليات التسويق الموجهة للزبناء بعروض ومعلومات تجارية وذلك عن طريق ( الهاتف – الفاكس – البريد الالكتروني ...)\n"]]></textFieldExpression></textField></elementGroup></band><band splitType="Prevent" height="58"><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="8" width="276" height="21" uuid="5541e925-2826-440b-98a2-189e1b9276a2" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="276" y="8" width="276" height="21" uuid="dd8ce67d-dddb-4b69-bb88-3083c2bbb3e1" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="8" width="276" height="21" uuid="747612b6-6eb1-41cb-a4f8-93de06c040b1"/><box/><textElement textAlignment="Left" verticalAlignment="Middle" markup="styled">

					<paragraph rightIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[" الوكالة  :  "]]></textFieldExpression></textField></elementGroup><elementGroup><rectangle><reportElement positionType="Float" stretchType="ElementGroupHeight" x="0" y="43" width="552" height="15" uuid="b6d032aa-a7b7-477d-bc4d-dca4d53d06fa" mode="Transparent"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="0" y="43" width="68" height="15" uuid="025d10ea-ce7a-469f-ad86-24731bb850de"/><box/><textElement textAlignment="Left" verticalAlignment="Middle" markup="html">
					<font fontName="Times New Roman" size="11" isBold="false" isUnderline="false"/>
